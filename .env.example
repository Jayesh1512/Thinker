# Database - Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# File Storage - Cloudinary credentials
# Get these from: Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin Authentication - Simple password (create your own secure password)
# This is a simple bearer token for MVP - upgrade to JWT/NextAuth later
ADMIN_PASSWORD="your-secure-admin-password-here"

# App URL
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Optional - for v1.5+)
# RESEND_API_KEY="..."
# or
# SENDGRID_API_KEY="..."

# NOTE: We're only using Supabase for PostgreSQL database hosting
# No Supabase Auth, Storage, or Realtime keys needed
